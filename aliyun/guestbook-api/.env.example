# 阿里云函数计算环境变量示例
# 这些变量只放在函数计算后端环境中，不能写入前端代码或 GitHub Pages。

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-oss-bucket-name
OSS_OBJECT_KEY=durian-hackathon-gallery/secret-grove/messages.json
OSS_ACCESS_KEY_ID=your-backend-only-access-key-id
OSS_ACCESS_KEY_SECRET=your-backend-only-access-key-secret

# 允许调用留言 API 的前端来源。正式部署建议只保留 GitHub Pages 域名和你的自定义域名。
ALLOWED_ORIGINS=https://paofuxiaomiao.github.io,http://localhost:3000,http://127.0.0.1:3000

MAX_MESSAGES=80
MAX_NAME_LENGTH=20
MAX_BODY_LENGTH=180
